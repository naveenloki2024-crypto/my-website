# Stripe API key (find at https://dashboard.stripe.com/test/apikeys)
# Use the sk_test_... key here. The pk_test_... key is public and cannot create sessions.
STRIPE_SECRET_KEY=sk_test_

# MySQL connection settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rare_habit
DB_PORT=3306

# Prisma / MySQL connection string (Prisma ORM for the Orders system)
# Format: mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
# Note: special chars in the password must be URL-encoded (@ -> %40, # -> %23, etc.)
DATABASE_URL="mysql://root:YOUR_MYSQL_ROOT_PASSWORD@localhost:3306/rare_habit"

# Stripe webhook secret (optional for local testing; see Stripe CLI)
STRIPE_WEBHOOK_SECRET=

# ===== Admin Dashboard =====
# Admin login credentials used by the seed script (node scripts/seed-admin.js).
# These stay server-side only. Never put them in frontend code.
ADMIN_EMAIL=admin@rarehabit.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=RARE HABIT Admin

# Secret used to sign admin session tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_JWT_SECRET=