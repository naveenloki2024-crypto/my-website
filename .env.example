# Stripe API keys (find at https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY stays server-side ONLY. The pk_test_... publishable key is
# public by design; it is only used by Stripe-hosted checkout when needed.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# MongoDB connection string (used by Mongoose for products, orders, admin)
# LOCAL MongoDB:
#   mongodb://127.0.0.1:27017/rare_habit
# CLOUD MongoDB (MongoDB Atlas):
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/rare_habit
# Note: special chars in the password must be URL-encoded (@ -> %40, # -> %23, etc.)
MONGODB_URI=mongodb://127.0.0.1:27017/rare_habit

# Stripe webhook secret (optional for local testing; see Stripe CLI)
STRIPE_WEBHOOK_SECRET=

# ===== Admin Dashboard =====
# Admin login credentials used by the seed script (node scripts/seed-admin.js).
# These stay server-side only. Never put them in frontend code.
ADMIN_EMAIL=admin@rarehabit.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=RARE HABIT Admin

# Secret used to sign admin session tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_JWT_SECRET=

# ===== Vercel (production) =====
# Add ALL of the variables above to the Vercel project's Environment Variables
# (Settings -> Environment Variables), with production values. At minimum:
#   MONGODB_URI           -> your CLOUD MongoDB connection string (mongodb+srv://...)
#   STRIPE_SECRET_KEY     -> your Stripe secret key
#   STRIPE_PUBLISHABLE_KEY-> your Stripe publishable key
#   STRIPE_WEBHOOK_SECRET -> Stripe webhook signing secret
#   ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME -> seed the first admin
#   ADMIN_JWT_SECRET      -> a long random value
# NEVER hardcode secrets in source files.